{
  "name": "omp-discord",
  "version": "0.1.2",
  "description": "Explicit, local Discord account operations for Oh My Pi.",
  "author": "DarkPhilosophy",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkPhilosophy/omp-discord.git"
  },
  "exports": "./src/index.ts",
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    ".github/CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "scan": "bun .scripts/scan-leaks.mjs",
    "verify": "bun run check && bun run typecheck && bun run test && bun run scan"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "^17.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@oh-my-pi/pi-coding-agent": "17.0.6",
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  }
}
